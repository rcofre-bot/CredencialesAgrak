<file path="src/App.css">
/* ─── Reset & Base ──────────────────────────────────── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --navy: #1a1a2e;
  --navy-mid: #16213e;
  --blue: #0f3460;
  --accent: #e94560;
  --accent-soft: #fde8ec;
  --green: #2e7d32;
  --green-soft: #e8f5e9;
  --red: #c62828;
  --red-soft: #fce4ec;
  --gray-50: #f8f9fb;
  --gray-100: #f0f2f5;
  --gray-200: #e2e6ec;
  --gray-400: #9aa0ab;
  --gray-600: #5a6170;
  --gray-800: #2c3140;
  --white: #ffffff;
  --font: 'DM Sans', system-ui, sans-serif;
  --mono: 'Space Mono', monospace;
  --radius-sm: 6px;
  --radius: 10px;
  --radius-lg: 16px;
  --shadow: 0 2px 12px rgba(26,26,46,0.08);
  --shadow-md: 0 6px 24px rgba(26,26,46,0.12);
}

body {
  font-family: var(--font);
  background: var(--gray-100);
  color: var(--gray-800);
  min-height: 100vh;
  -webkit-font-smoothing: antialiased;
}

/* ─── Layout ─────────────────────────────────────────── */
.app-layout {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.main-content {
  max-width: 1100px;
  width: 100%;
  margin: 0 auto;
  padding: 2rem 1.5rem;
  flex: 1;
}

/* ─── TopBar ─────────────────────────────────────────── */
.topbar {
  background: var(--navy);
  color: white;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 2rem;
  height: 60px;
  position: sticky;
  top: 0;
  z-index: 100;
  border-bottom: 2px solid var(--accent);
}

.topbar-brand {
  display: flex;
  align-items: center;
  gap: 10px;
}

.topbar-icon {
  font-size: 22px;
}

.topbar-title {
  font-size: 15px;
  font-weight: 600;
  letter-spacing: 0.3px;
  color: white;
}

.topbar-user {
  display: flex;
  align-items: center;
  gap: 10px;
}

.user-avatar {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  border: 2px solid rgba(255,255,255,0.3);
}

.user-name {
  font-size: 13px;
  color: rgba(255,255,255,0.8);
}

.btn-logout {
  background: rgba(255,255,255,0.1);
  border: 1px solid rgba(255,255,255,0.2);
  color: white;
  font-family: var(--font);
  font-size: 12px;
  padding: 5px 12px;
  border-radius: var(--radius-sm);
  cursor: pointer;
  transition: background 0.15s;
}

.btn-logout:hover {
  background: rgba(255,255,255,0.2);
}

/* ─── Stats ──────────────────────────────────────────── */
.stats-row {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
  gap: 14px;
  margin-bottom: 1.5rem;
}

.stat-card {
  background: var(--white);
  border-radius: var(--radius);
  padding: 1rem 1.25rem;
  box-shadow: var(--shadow);
  border: 1px solid var(--gray-200);
}

.stat-label {
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 1px;
  color: var(--gray-400);
  margin-bottom: 6px;
  font-weight: 500;
}

.stat-num {
  font-size: 28px;
  font-weight: 600;
  color: var(--navy);
  font-family: var(--mono);
}

.stat-activo .stat-num { color: var(--green); }
.stat-inactivo .stat-num { color: var(--red); }

.stat-logo {
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 70px;
  border: 2px dashed var(--gray-200);
  transition: border-color 0.15s;
}

.stat-logo:hover {
  border-color: var(--accent);
}

.stat-logo-img {
  max-height: 44px;
  max-width: 100%;
  object-fit: contain;
}

.stat-logo-placeholder {
  font-size: 12px;
  color: var(--gray-400);
  text-align: center;
}

/* ─── Toolbar ────────────────────────────────────────── */
.toolbar {
  display: flex;
  gap: 10px;
  margin-bottom: 1rem;
  flex-wrap: wrap;
}

.search-wrap {
  flex: 1;
  min-width: 200px;
}

.search-input {
  width: 100%;
  padding: 9px 14px;
  border: 1px solid var(--gray-200);
  border-radius: var(--radius);
  font-family: var(--font);
  font-size: 14px;
  background: var(--white);
  color: var(--gray-800);
  outline: none;
  transition: border-color 0.15s, box-shadow 0.15s;
}

.search-input:focus {
  border-color: var(--navy-mid);
  box-shadow: 0 0 0 3px rgba(26,26,46,0.07);
}

.filter-select {
  padding: 9px 14px;
  border: 1px solid var(--gray-200);
  border-radius: var(--radius);
  font-family: var(--font);
  font-size: 14px;
  background: var(--white);
  color: var(--gray-800);
  outline: none;
  cursor: pointer;
}

/* ─── Buttons ────────────────────────────────────────── */
.btn-primary {
  background: var(--navy);
  color: white;
  border: none;
  border-radius: var(--radius);
  padding: 9px 20px;
  font-family: var(--font);
  font-size: 14px;
  font-weight: 500;
  cursor: pointer;
  transition: background 0.15s, transform 0.1s;
}

.btn-primary:hover { background: var(--blue); }
.btn-primary:active { transform: scale(0.98); }
.btn-primary:disabled { opacity: 0.5; cursor: not-allowed; }

.btn-secondary {
  background: var(--white);
  color: var(--gray-800);
  border: 1px solid var(--gray-200);
  border-radius: var(--radius);
  padding: 9px 20px;
  font-family: var(--font);
  font-size: 14px;
  font-weight: 500;
  cursor: pointer;
  transition: background 0.15s;
}

.btn-secondary:hover { background: var(--gray-50); }
.btn-secondary:disabled { opacity: 0.5; cursor: not-allowed; }

.btn-icon {
  background: none;
  border: none;
  color: var(--gray-600);
  font-size: 18px;
  cursor: pointer;
  padding: 4px;
  border-radius: var(--radius-sm);
  line-height: 1;
}

.btn-icon:hover { background: var(--gray-100); }

/* ─── Table ──────────────────────────────────────────── */
.table-wrap {
  background: var(--white);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow);
  overflow: hidden;
  border: 1px solid var(--gray-200);
}

.workers-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 14px;
}

.workers-table thead {
  background: var(--navy);
  color: white;
}

.workers-table th {
  padding: 12px 16px;
  text-align: left;
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.8px;
  text-transform: uppercase;
}

.workers-table td {
  padding: 13px 16px;
  border-bottom: 1px solid var(--gray-100);
  color: var(--gray-800);
}

.workers-table tbody tr:last-child td {
  border-bottom: none;
}

.workers-table tbody tr:hover td {
  background: var(--gray-50);
}

.cell-mono {
  font-family: var(--mono);
  font-size: 12px;
}

.cell-name {
  font-weight: 500;
}

.cell-actions {
  display: flex;
  gap: 6px;
}

/* ─── Badges ─────────────────────────────────────────── */
.badge {
  display: inline-block;
  padding: 3px 10px;
  border-radius: 20px;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.3px;
}

.badge-activo { background: var(--green-soft); color: var(--green); }
.badge-inactivo { background: var(--red-soft); color: var(--red); }

/* ─── Action Buttons ─────────────────────────────────── */
.btn-action {
  background: var(--gray-100);
  border: 1px solid var(--gray-200);
  border-radius: var(--radius-sm);
  padding: 5px 10px;
  font-size: 12px;
  font-family: var(--font);
  cursor: pointer;
  font-weight: 500;
  transition: background 0.12s;
}

.btn-action:hover { background: var(--gray-200); }
.btn-action-warn:hover { background: var(--red-soft); border-color: var(--red); }
.btn-action-ok:hover { background: var(--green-soft); border-color: var(--green); }

/* ─── Empty & Loading ────────────────────────────────── */
.empty-state {
  text-align: center;
  padding: 4rem 2rem;
  color: var(--gray-400);
}

.empty-icon { font-size: 40px; margin-bottom: 12px; }

.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 4rem;
}

/* ─── Form Card ──────────────────────────────────────── */
.form-card {
  background: var(--white);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-md);
  padding: 2rem;
  max-width: 680px;
  margin: 0 auto;
  border: 1px solid var(--gray-200);
}

.form-title {
  font-size: 18px;
  font-weight: 600;
  color: var(--navy);
  margin-bottom: 1.5rem;
  padding-bottom: 1rem;
  border-bottom: 1px solid var(--gray-100);
}

.form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rem;
  margin-bottom: 1.5rem;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.form-group label {
  font-size: 12px;
  font-weight: 500;
  color: var(--gray-600);
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.form-group input,
.form-group select {
  padding: 9px 12px;
  border: 1px solid var(--gray-200);
  border-radius: var(--radius);
  font-family: var(--font);
  font-size: 14px;
  color: var(--gray-800);
  background: var(--white);
  outline: none;
  transition: border-color 0.15s, box-shadow 0.15s;
}

.form-group input:focus,
.form-group select:focus {
  border-color: var(--navy-mid);
  box-shadow: 0 0 0 3px rgba(26,26,46,0.07);
}

.form-actions {
  display: flex;
  gap: 10px;
  justify-content: flex-end;
}

.alert-error {
  background: var(--red-soft);
  color: var(--red);
  border: 1px solid #f5b8c0;
  border-radius: var(--radius);
  padding: 10px 14px;
  font-size: 13px;
  margin-bottom: 1rem;
}

/* ─── Modal ──────────────────────────────────────────── */
.modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(26,26,46,0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
  padding: 1rem;
}

.modal-box {
  background: var(--white);
  border-radius: var(--radius-lg);
  width: 100%;
  max-width: 380px;
  box-shadow: var(--shadow-md);
  overflow: hidden;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1rem 1.25rem;
  border-bottom: 1px solid var(--gray-100);
}

.modal-header h2 {
  font-size: 16px;
  font-weight: 600;
  color: var(--navy);
}

.modal-actions {
  display: flex;
  gap: 10px;
  padding: 1rem 1.25rem;
  border-top: 1px solid var(--gray-100);
  justify-content: flex-end;
}

/* ─── Card Preview (QR Card) ─────────────────────────── */
.card-preview {
  border-radius: 12px;
  overflow: hidden;
  margin: 1rem 1.25rem;
  border: 1px solid var(--gray-200);
}

.card-header-stripe {
  background: linear-gradient(135deg, var(--navy) 0%, var(--blue) 100%);
  padding: 1.2rem 1.25rem 1rem;
  text-align: center;
}

.card-logo-area {
  min-height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8px;
}

.card-logo-img {
  max-height: 44px;
  max-width: 160px;
  object-fit: contain;
}

.card-logo-placeholder {
  font-size: 12px;
  color: rgba(255,255,255,0.6);
  font-weight: 500;
  letter-spacing: 2px;
  text-transform: uppercase;
}

.card-company-label {
  font-size: 10px;
  color: rgba(255,255,255,0.5);
  letter-spacing: 1.5px;
  text-transform: uppercase;
}

.card-body {
  padding: 1rem 1.25rem;
  background: var(--white);
}

.card-name {
  font-size: 17px;
  font-weight: 600;
  color: var(--navy);
  margin-bottom: 2px;
}

.card-rut {
  font-family: var(--mono);
  font-size: 12px;
  color: var(--gray-400);
  margin-bottom: 12px;
}

.card-meta-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
  margin-bottom: 14px;
}

.card-meta-item {
